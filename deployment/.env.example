# Copy to deployment/.env (git-ignored) and fill in. Read by docker compose.

# Which optional services start: "app" = backend + frontend, "local" = local S3 (SeaweedFS).
# Local machine: app,local    EC2: app
COMPOSE_PROFILES=app,local

# Required. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Use a strong value on EC2. Only applies when the Postgres volume is first created.
POSTGRES_PASSWORD=classsight

# Address browsers use to reach the API (baked into the frontend at build time).
# Local: http://localhost:8000    EC2: http://<instance-public-ip>:8000
VITE_API_BASE_URL=http://localhost:8000
# Must include the address the frontend is opened from. EC2: ["http://<instance-public-ip>"]
CORS_ALLOWED_ORIGINS=["http://localhost"]

S3_BUCKET_NAME=classsight-photos
AWS_REGION=us-east-1

# ---- local S3 only (ignored on EC2 by docker-compose.ec2.yml) ----
S3_ENDPOINT_URL=http://s3:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
LOCAL_S3_ACCESS_KEY=classsight
LOCAL_S3_SECRET_KEY=classsight-local-s3

ENROLL_AUGMENT=false
LOG_LEVEL=INFO
